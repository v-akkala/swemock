{
  "name": "swemock",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @swemock/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @swemock/web db:generate",
    "test:sandbox": "pnpm --filter @swemock/runner test:sandbox",
    "content:new": "tsx scripts/content.ts new",
    "content:gen": "tsx scripts/content.ts gen",
    "content:validate": "tsx scripts/content.ts validate"
  },
  "devDependencies": {
    "tsx": "4.23.15"
  }
}
