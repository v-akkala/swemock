# Copy to .env to override defaults. Never commit .env.
# All values are optional.

# Host port (bound to 127.0.0.1 only).
SWEMOCK_PORT=3000

# Extra Host header values the app accepts besides localhost (comma-separated).
SWEMOCK_ALLOWED_HOSTS=

# AI provider overrides (Settings → AI provider is the usual way to configure these).
# SWEMOCK_PROVIDER=none
# SWEMOCK_MODEL_INTERVIEWER=
# SWEMOCK_MODEL_ASSISTANT=
# SWEMOCK_MODEL_GRADER=
# SWEMOCK_MODEL_FAST=
